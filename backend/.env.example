POSTGRES_USER=styleverse_user
POSTGRES_PASSWORD=change_me
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=styleverse_ai
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/styleverse
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET_KEY=change_me_to_a_strong_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Media storage. Local is dependency-free for development; implement a
# provider adapter before setting this to an object-storage provider.
MEDIA_STORAGE=local
# Optional public CDN/base URL. Defaults to /media for local storage.
MEDIA_BASE_URL=
# Optional local media root (defaults to backend/uploads; keep it out of Git).
MEDIA_LOCAL_ROOT=

# Virtual Try-On processor mode: "composite" (default, real image compositing) or "stub" (placeholder)
TRYON_PROCESSOR_MODE=composite

# Admin API key for protected ingestion endpoint (X-Admin-Key header)
ADMIN_API_KEY=change_me_admin_key

# ---------------------------------------------------------------------------
# Real merchant connector: Etsy Open API v3 (officially documented API)
# Docs: https://developers.etsy.com/documentation/
# Get a free key from https://www.etsy.com/developers/ - NEVER commit a real
# key here. The connector stays disabled until ETSY_ENABLED=true.
# ---------------------------------------------------------------------------
ETSY_ENABLED=false
ETSY_API_KEY=
# Official API base URL (override only if Etsy documents a new version)
ETSY_BASE_URL=https://openapi.etsy.com/v3
# Default keyword search for merchants whose feed_type is 'etsy'
ETSY_KEYWORDS=
# Safety bounds: page size <=100 per docs, max pages caps work per sync
ETSY_PAGE_SIZE=25
ETSY_MAX_PAGES=3
ETSY_TIMEOUT_SECONDS=15
