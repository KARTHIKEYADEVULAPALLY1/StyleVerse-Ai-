# StyleVerse AI - Environment Variables
# Copy this file to .env and configure for your environment

# =============================================================================
# API Configuration
# =============================================================================
# Main API Base URL - This is the ONLY required configuration
# Development: http://127.0.0.1:8000
# Production:  https://your-production-api.example.com
VITE_API_URL=http://127.0.0.1:8000

# Assistant API URL (optional - defaults to using the main API URL if not set)
# VITE_ASSISTANT_API_URL=http://127.0.0.1:8000/api/assistant
